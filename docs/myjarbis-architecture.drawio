<mxfile host="app.diagrams.net" type="device">
  <diagram name="1 · Architecture">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="&lt;b&gt;MyJarbis — architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; color: #6B6E78&quot;&gt;A memory + process layer over MCP. Installed on top of Claude Code, and an explicit override of it.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="56" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;DEVELOPER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Types `myjarbis start`, or `claude` then `/jarbis`. After that it is natural language — there is only one slash command." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1100" height="68" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;CLAUDE CODE  (harness)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fires hooks and loads skills from .claude/skills/. MyJarbis does not replace it; it sits above it and outranks its defaults.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;SessionStart — resolve project, resume the module, materialise skills&lt;br&gt;&amp;#8226;&amp;#160;UserPromptSubmit — optional nudges&lt;br&gt;&amp;#8226;&amp;#160;Stop — fires EVERY turn (reminder only; it does not close anything)&lt;br&gt;&amp;#8226;&amp;#160;SessionEnd — closes any open session automatically" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="1100" height="108" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;MCP SERVER  (Node + TypeScript, stdio)&lt;/b&gt;&lt;br&gt;&lt;br&gt;32 tools. 20 are always in the prompt; 12 admin-shaped ones ship only a name and load their schema on demand, so they cost nothing when unused.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;memory:    save_observation · update_observation · suggest_topic_key&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;add_ref · find_by_ref · search · load_project_core · load_module&lt;br&gt;&amp;#8226;&amp;#160;state:     get_project_state · set_project_state · resume&lt;br&gt;&amp;#8226;&amp;#160;process:   get_workflow · list_workflows · set_workflow_step&lt;br&gt;&amp;#8226;&amp;#160;setup:     list/set_provider · list_context_kinds · *_skills · import_*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="1100" height="150" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;SCOPE  —  the tenant boundary, in code&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bound to the CONNECTION, never passed per query. Before v0.3 isolation was the filesystem&amp;#x27;s job (one file per project); a shared brain removes that, and one forgotten parameter would widen a read across clients.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;{ kind: &amp;#x27;project&amp;#x27;, id }  —  the only rows this connection can see&lt;br&gt;&amp;#8226;&amp;#160;{ kind: &amp;#x27;all&amp;#x27;, reason }  —  crossing projects, with a stated reason&lt;br&gt;&amp;#8226;&amp;#160;No scope bound → the read FAILS. Another project&amp;#x27;s id → REFUSED." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#8B1A1A;fontColor=#1C1D22;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="1100" height="98" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;SQLite  —  better-sqlite3 + FTS5   (schema v4)&lt;/b&gt;&lt;br&gt;&lt;br&gt;One file per project by default. The shared brain is opt-in and exists so a cross-cutting change is one action instead of N visits.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;&amp;lt;project&amp;gt;/.myjarbis/memory.db     isolation = silo    (default)&lt;br&gt;&amp;#8226;&amp;#160;~/.myjarbis/memory.db             isolation = shared  (opt-in)&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;orgs → projects → project_context · modules · skills&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;→ project_state · providers · workflows → workflow_steps&lt;br&gt;&amp;#8226;&amp;#160;modules → module_context → sessions → observations → refs&lt;br&gt;&amp;#8226;&amp;#160;context_kinds — the taxonomy, a catalogue rather than free text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="638" width="1100" height="176" as="geometry"/></mxCell>
        <mxCell id="e8" value="/jarbis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;fontSize=10;fontColor=#6B6E78;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="MCP over stdio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;fontSize=10;fontColor=#6B6E78;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="every read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;fontSize=10;fontColor=#6B6E78;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="scoped SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;fontSize=10;fontColor=#6B6E78;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;Resolving “which project is this?”&lt;/b&gt;&lt;br&gt;&lt;br&gt;In order, stopping at the first hit. It NEVER creates a brain — only `myjarbis init` does, which is why a command run in a stray directory no longer leaves an empty database behind.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;1. explicit --project / MYJARBIS_PROJECT&lt;br&gt;&amp;#8226;&amp;#160;2. the normalised git remote  (survives a different path on another machine)&lt;br&gt;&amp;#8226;&amp;#160;3. the nearest enclosing registered path  (so subdirectories work)&lt;br&gt;&amp;#8226;&amp;#160;4. fail with a clear message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F8;strokeColor=#D7D9E0;fontColor=#1C1D22;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1100" height="92" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2 · A session">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="&lt;b&gt;A session, start to finish&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; color: #6B6E78&quot;&gt;What actually happens between opening the terminal and the brain being ready for tomorrow.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="56" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;1 · Open&lt;/b&gt;&lt;br&gt;&lt;br&gt;`myjarbis start`, or `claude` + `/jarbis`.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;SessionStart resolves the project by git remote, then by path.&lt;br&gt;&amp;#8226;&amp;#160;If a module is already active it resumes straight into it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1100" height="118" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;2 · start_session(module)&lt;/b&gt;&lt;br&gt;&lt;br&gt;One call returns everything bootstrap needs.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;projectContext + moduleContext as ~240-char excerpts (the catalogue)&lt;br&gt;&amp;#8226;&amp;#160;stories as localIds only — no bodies, or one module would flood context&lt;br&gt;&amp;#8226;&amp;#160;previousSession.nextSession IN FULL — the actual resume point&lt;br&gt;&amp;#8226;&amp;#160;Any session left open in this module is closed first, retroactively." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="254" width="1100" height="150" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;fontSize=10;fontColor=#6B6E78;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;3 · Skills materialise&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rows become files Claude Code can read.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;project-level + the active module&amp;#x27;s skills → .claude/skills/myjarbis-*/&lt;br&gt;&amp;#8226;&amp;#160;Inserting into the DB is not enough: the agent reads the directory." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1100" height="118" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;fontSize=10;fontColor=#6B6E78;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;4 · Work — natural language&lt;/b&gt;&lt;br&gt;&lt;br&gt;The agent calls tools; you talk.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;a decision / gotcha / closed story → save_observation&lt;br&gt;&amp;#8226;&amp;#160;something with a CURRENT VALUE → topic_key, so saving again UPDATES it&lt;br&gt;&amp;#8226;&amp;#160;about to repeat an outward action → find_by_ref first&lt;br&gt;&amp;#8226;&amp;#160;“what is the process here?” → get_workflow, resolved org→project→user" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="574" width="1100" height="150" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;fontSize=10;fontColor=#6B6E78;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;5 · Gates&lt;/b&gt;&lt;br&gt;&lt;br&gt;A step with gate=approve is a stop, not a hint.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;capability is abstract (tracker.comment) — the provider row names the tool&lt;br&gt;&amp;#8226;&amp;#160;Conditions are decidable (branch ~= release/*), never free text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1100" height="118" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;fontSize=10;fontColor=#6B6E78;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;6 · Close&lt;/b&gt;&lt;br&gt;&lt;br&gt;Curated if you say so; automatic either way.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;end_session(summary, next_session) — always better, it says what you MEANT&lt;br&gt;&amp;#8226;&amp;#160;otherwise SessionEnd writes a generated summary from observations + commits&lt;br&gt;&amp;#8226;&amp;#160;the resume point prefers project_state, then the last progress note&lt;br&gt;&amp;#8226;&amp;#160;generated text is prefixed [auto] and the next agent is told so" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#8B1A1A;fontColor=#1C1D22;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="894" width="1100" height="150" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;fontSize=10;fontColor=#6B6E78;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;Why the close matters more than it looks&lt;/b&gt;&lt;br&gt;&lt;br&gt;`summary` was NULL on 2 of 2 sessions in one real project and 2 of 10 in another. A session that never closes makes `resume` return nothing AND strips hasNextSession / lastSessionEndedAt from every module — which is the signal used to choose which module to open. It fails silently.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;So it closes in TWO places: SessionEnd, and the next start_session.&lt;br&gt;&amp;#8226;&amp;#160;A killed terminal fires no hook — a guarantee that needs a clean exit is not one." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F8;strokeColor=#D7D9E0;fontColor=#1C1D22;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="1100" height="86" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 · What v0.3 added">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="&lt;b&gt;v0.3 — the habits, and what replaced them&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; color: #6B6E78&quot;&gt;Each change exists because a measurable habit had formed in real brains: 138 observations, 15 context rows, 12 sessions, 3 projects.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="56" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Org pack&lt;/b&gt;&lt;br&gt;&lt;br&gt;Two of three real projects never received the org layer at all — one re-learned and re-documented a gotcha already written in a skill that was never materialised there.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;skills/ + overrides/ + context-kinds.yml + workflows/ + providers.yml&lt;br&gt;&amp;#8226;&amp;#160;overrides/ REPLACES a baseline; applied after it, then materialised to disk&lt;br&gt;&amp;#8226;&amp;#160;org sync — one command re-applies to every project of the org" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1100" height="148" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Taxonomy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Three projects invented three vocabularies for the same seven ideas. observations.kind, which code fixes, came out identical in all three.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;context_kinds is a catalogue; an unknown kind is rejected WITH the nearest match&lt;br&gt;&amp;#8226;&amp;#160;a pack adds its own; no vendor name belongs here (tracker_rules, not a product)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="1100" height="132" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;topic_key + refs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Notes were corrected by retitling: &amp;quot;CORRECTS note 80&amp;quot;, &amp;quot;DEFINITIVE — supersedes 80 and 81&amp;quot;. Six of those in one brain.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;topic_key — saving again updates that note instead of competing with it&lt;br&gt;&amp;#8226;&amp;#160;refs + find_by_ref — &amp;quot;did I already post this?&amp;quot; as a boolean, not a re-read" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="1100" height="132" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;project_state&lt;/b&gt;&lt;br&gt;&lt;br&gt;Three notes in one project were the same note, each announcing it replaced the last.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;one row, overwritten; history is what observations are for&lt;br&gt;&amp;#8226;&amp;#160;an advisory lock with a TTL — no TTL wedges the project when a process dies" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="564" width="1100" height="132" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Resolution by git remote&lt;/b&gt;&lt;br&gt;&lt;br&gt;cwd-exact matching meant a subdirectory registered a SECOND project, and a clone at another path was a new project.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;--project → git remote → nearest registered path → fail&lt;br&gt;&amp;#8226;&amp;#160;never creates a brain; `init` alone does" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1100" height="132" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;Brain sync&lt;/b&gt;&lt;br&gt;&lt;br&gt;Versioning the binary .db split the brain once already.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;deterministic NDJSON per table, scoped to ONE project&lt;br&gt;&amp;#8226;&amp;#160;export refuses if providers.config carries anything credential-shaped" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="856" width="1100" height="132" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;Workflows as data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Three consecutive decisions contradicted each other about when to stop for approval — a field changing value, written as three documents.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;rows with org → project → user inheritance, resolved into ONE list&lt;br&gt;&amp;#8226;&amp;#160;abstract capability + providers, so the core never learns a vendor&amp;#x27;s name&lt;br&gt;&amp;#8226;&amp;#160;decidable conditions; anything advisory goes in notes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1002" width="1100" height="148" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;The condition that ordered all of it&lt;/b&gt;&lt;br&gt;&lt;br&gt;The core learns MECHANISMS, never CONTENT. If a change needs to know the name of a company, a client or a commercial tool, it is either designed wrong or it belongs in a private pack.&lt;br&gt;&lt;br&gt;&amp;#8226;&amp;#160;the loader is here — the pack&amp;#x27;s contents are not&lt;br&gt;&amp;#8226;&amp;#160;`tracker.comment` is here — which tracker is a providers row&lt;br&gt;&amp;#8226;&amp;#160;the taxonomy mechanism is here — an org&amp;#x27;s extra labels are not&lt;br&gt;&amp;#8226;&amp;#160;verified: `git grep` for org / client / tracker names returns nothing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#8B1A1A;fontColor=#1C1D22;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1174" width="1100" height="104" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
